# Registry pin — defends against `ERR_INVALID_THIS` flakes on Vercel where
# Corepack-resolved registries can resolve to a CDN edge with the
# undici-this bug.
registry=https://registry.npmjs.org/

# Aggressive retry budget. The default of 2 retries with a short backoff is
# what makes a single transient registry hiccup blow up the entire install.
# These values match what npm itself uses on stalled CI.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
network-timeout=300000

# pnpm-specific — the project's deps assume hoisted peers (antd / react etc),
# and `auto-install-peers` keeps installs reproducible without manually
# pinning every transitive peer.
auto-install-peers=true
strict-peer-dependencies=false

# Avoid Vercel re-resolving every package on every preview build. With this
# off, pnpm uses the lockfile as the source of truth when one is present.
prefer-frozen-lockfile=false
