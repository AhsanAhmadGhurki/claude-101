# Registry pin — defends against `ERR_INVALID_THIS` flakes on Vercel where
# Corepack-resolved registries can resolve to a CDN edge with the
# undici-this bug.
registry=https://registry.npmjs.org/

# Aggressive retry budget. The default of 2 retries with a short backoff is
# what makes a single transient registry hiccup blow up the entire install.
# These values match what npm itself uses on stalled CI.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
network-timeout=300000

# pnpm-specific — the project's deps assume hoisted peers (antd / react etc),
# and `auto-install-peers` keeps installs reproducible without manually
# pinning every transitive peer.
auto-install-peers=true
strict-peer-dependencies=false

# Avoid Vercel re-resolving every package on every preview build. With this
# off, pnpm uses the lockfile as the source of truth when one is present.
prefer-frozen-lockfile=false

# Force pnpm to download and use a known-good Node version for the install
# itself, regardless of what the host runtime is. The undici/URLSearchParams
# `ERR_INVALID_THIS` bug is fixed in 20.10+; pinning 20.18.1 here is a
# definitive escape hatch even if Vercel's Node provisioning ever drifts to
# an older 20.x patch. pnpm bootstraps this once and caches it across builds.
use-node-version=20.18.1

# Serialize registry fetches. The ERR_INVALID_THIS bug is triggered by
# concurrent fetches that share `this` state in undici; with concurrency=1
# the trigger goes away entirely, at the cost of a slightly slower install.
# Trading ~10 seconds of build time for "never breaks again" is worth it.
network-concurrency=1
