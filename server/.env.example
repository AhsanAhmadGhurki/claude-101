# Copy this file to `.env` and fill in real values.

# ─── Core ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/adventure-ai

# Origin allowed by CORS (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# ─── JWT / refresh tokens ────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── Cookies ─────────────────────────────────────────────────────────────
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# `lax` is correct for same-origin or simple cross-origin auth flows.
COOKIE_SAMESITE=lax
# Optional explicit domain (omit for default same-host).
# COOKIE_DOMAIN=

# ─── Email verification gate ─────────────────────────────────────────────
# When true, /signin returns 403 until the user verifies their email.
REQUIRE_EMAIL_VERIFICATION=true

# ─── SMTP (optional) ─────────────────────────────────────────────────────
# When SMTP_HOST is unset, the email service logs messages to the console
# and returns the link in API responses (DEV ONLY) so you can test flows
# without setting up real email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Adventure AI <noreply@adventure.local>"
