# Copy this file to `.env` and fill in real values.

# ─── Core ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/adventure-ai

# Origin(s) allowed by CORS. Comma-separated when more than one. Production
# typically lists the prod domain, the Vercel preview wildcard pattern is
# NOT supported here — set each preview URL or your prod domain explicitly.
# Example for prod:
#   CLIENT_ORIGIN=https://your-app.vercel.app,https://your-domain.com
CLIENT_ORIGIN=http://localhost:5173

# ─── JWT / refresh tokens ────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── Cookies ─────────────────────────────────────────────────────────────
# Local dev (HTTP, same-origin via Vite proxy or localhost):
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
#
# Production (frontend on Vercel, backend on a different HTTPS domain):
#   COOKIE_SECURE=true        # required: browsers refuse insecure cookies on HTTPS
#   COOKIE_SAMESITE=none      # required: cross-site requests need SameSite=None
#                              # (None only works in combination with Secure=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional explicit domain (omit for default same-host).
# COOKIE_DOMAIN=

# ─── Email verification gate ─────────────────────────────────────────────
# When true, /signin returns 403 until the user verifies their email.
REQUIRE_EMAIL_VERIFICATION=true

# ─── SMTP (optional) ─────────────────────────────────────────────────────
# When SMTP_HOST is unset, the email service logs messages to the console
# and returns the link in API responses (DEV ONLY) so you can test flows
# without setting up real email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Adventure AI <noreply@adventure.local>"
